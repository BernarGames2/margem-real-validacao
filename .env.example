# Copie para .env.local e preencha com os dados do SEU projeto Supabase
# (Project Settings > API Keys). Os dois valores são públicos por natureza:
# vão para o navegador de quem visita a página.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Use a chave publicável (sb_publishable_...) ou a chave anon antiga (eyJ...).
# NUNCA coloque aqui a chave secreta (sb_secret_...) nem a service_role.
VITE_SUPABASE_ANON_KEY=sb_publishable_COLE_AQUI
